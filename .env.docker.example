POSTGRES_USER=postgres
# REQUIRED. The RAW password of the bundled postgres container (used only by
# that container, never inside a URL). No default. Recommended:
#   openssl rand -hex 24
# Hex needs no escaping anywhere. Any other value: wrap it in single quotes here
# ('...') so `#`, `$` and spaces are kept literally.
POSTGRES_PASSWORD=
POSTGRES_DB=paypoq_os
# Published on 127.0.0.1 only (host tools/host-run API use localhost).
POSTGRES_PORT=55432

# REQUIRED. Connection URI for api/migrate/bootstrap. It is never built from
# POSTGRES_PASSWORD; write it explicitly.
# - Bundled database:
#     postgresql://<POSTGRES_USER>:<password>@postgres:5432/<POSTGRES_DB>?schema=public
#   <password> is POSTGRES_PASSWORD percent-encoded for a URI: identical for a
#   hex password; otherwise  @ -> %40  : -> %3A  / -> %2F  % -> %25  # -> %23
#   ? -> %3F  (e.g. node -p "encodeURIComponent(process.argv[1])" '<raw>').
#   A mismatch fails closed: the API refuses to start and readiness is 503.
# - External/managed database: its own URI. The bundled postgres container
#   still starts (the api service depends on it) but is not used.
DATABASE_URL=
# Compose runs the API with NODE_ENV=production unless set here. Production
# rejects localhost CORS origins and the placeholder secrets below, so for local
# development with these example values uncomment:
# NODE_ENV=development
# PRODUCTION: exact https origin(s) only; '*'/localhost are rejected at startup.
CORS_ORIGIN=http://localhost:3000
# api/web are published on 127.0.0.1 only; a reverse proxy on the host is the
# public entry point. Change only for local testing from other devices, never
# on a server: a direct binding lets clients forge their rate-limit IP.
# API_BIND_ADDRESS=127.0.0.1
# WEB_BIND_ADDRESS=127.0.0.1
# TRUSTED_PROXIES=loopback,uniquelocal
# Baked into the browser bundle at build time (the web image refuses to build
# without it); a runtime change does not affect an already-built bundle.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001
API_BASE_URL=http://api:3001

JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=paypoq_refresh_token

PLATFORM_JWT_ACCESS_SECRET=replace-with-long-random-platform-secret
PLATFORM_AUTH_COOKIE_NAME=paypoq_platform_refresh_token

TELEGRAM_LINK_TOKEN_SECRET=replace-with-long-random-telegram-link-secret
BOT_INTERNAL_API_KEY=replace-with-long-random-bot-internal-key
FACTORY_TV_ACCESS_TOKEN=replace-with-long-random-factory-tv-display-token
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
BOT_MODE=polling

# Release identity reported by GET /health.
BUILD_SHA=local

# One-shot platform bootstrap (used only by `--profile bootstrap`).
# PLATFORM_BOOTSTRAP_EMAIL=ops@example.com
# PLATFORM_BOOTSTRAP_PASSWORD=
