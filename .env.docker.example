POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paypoq_os
POSTGRES_PORT=55432

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/paypoq_os?schema=public
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001
API_BASE_URL=http://api:3001

JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=paypoq_refresh_token

PLATFORM_JWT_ACCESS_SECRET=replace-with-long-random-platform-secret
PLATFORM_AUTH_COOKIE_NAME=paypoq_platform_refresh_token

TELEGRAM_LINK_TOKEN_SECRET=replace-with-long-random-telegram-link-secret
BOT_INTERNAL_API_KEY=replace-with-long-random-bot-internal-key
FACTORY_TV_ACCESS_TOKEN=replace-with-long-random-factory-tv-display-token
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
BOT_MODE=polling
