{
  "name": "@paypoq/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:android": "expo export --platform android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deps:check": "expo install --check",
    "test": "node --no-warnings --experimental-strip-types scripts/unit-test.mjs && node --no-warnings --experimental-strip-types scripts/session-integration-test.mjs && node --import ./scripts/context-test-runtime.mjs --no-warnings --experimental-strip-types scripts/context-integration-test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@paypoq/shared": "workspace:*",
    "@tanstack/react-query": "^5.80.7",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.29.0",
    "eslint-config-expo": "^10.0.0",
    "prettier": "^3.5.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  }
}
