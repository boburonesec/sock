  inspectionRoundId  String
  machineId          String
  productionRunId    String
  mechanicEmployeeId String
  status             QualityIssueStatus @default(ATTENTION)
  details            Json
  recheckDueAt       DateTime
  resolvedAt         DateTime?
  resolvedByUserId   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  factory         Factory         @relation(fields: [factoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  inspectionRound InspectionRound @relation(fields: [inspectionRoundId, tenantId], references: [id, tenantId], onDelete: Restrict)
  machine         Machine         @relation(fields: [machineId, tenantId, factoryId], references: [id, tenantId, factoryId], onDelete: Restrict)
  productionRun   ProductionRun   @relation(fields: [productionRunId, tenantId, factoryId], references: [id, tenantId, factoryId], onDelete: Restrict)
  mechanic        Employee        @relation(fields: [mechanicEmployeeId, tenantId, factoryId], references: [id, tenantId, factoryId], onDelete: Restrict)
  resolvedBy      User?           @relation("QualityIssueResolver", fields: [resolvedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, factoryId, status, recheckDueAt])
}

model Notification {
  id              String    @id @default(cuid())
  tenantId        String
  recipientUserId String
  type            String
  title           String
  body            String
  sourceType      String?
  sourceId        String?
  dedupeKey       String
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient  User                   @relation("NotificationRecipient", fields: [recipientUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([id, tenantId])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, recipientUserId, readAt, createdAt])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  tenantId       String
  notificationId String
  status         NotificationDeliveryStatus @default(PENDING)
  telegramChatId String?
  attemptCount   Int                        @default(0)
  leaseUntil     DateTime?
  nextAttemptAt  DateTime                   @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notification Notification @relation(fields: [notificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, notificationId])
  @@index([status, nextAttemptAt, leaseUntil])
}

model PayrollPeriod {
  id                   String              @id @default(cuid())
  tenantId             String
  factoryId            String
  month                DateTime            @db.Date
  status               PayrollPeriodStatus @default(DRAFT)
  totalWorkedAmount    Decimal             @db.Decimal(14, 2)
  totalBonusAmount     Decimal             @db.Decimal(14, 2)
  totalPenaltyAmount   Decimal             @db.Decimal(14, 2)
  totalAdvanceAmount   Decimal             @db.Decimal(14, 2)
  totalFinalAmount     Decimal             @db.Decimal(14, 2)
  totalPaidAmount      Decimal             @db.Decimal(14, 2)
  totalRemainingAmount Decimal             @db.Decimal(14, 2)
  calculatedAt         DateTime?
  closedAt             DateTime?
  calculationRevision  Int                 @default(0)
  approvedRevision     Int?
  approvedByUserId     String?
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  factory     Factory              @relation(fields: [factoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  adjustments EmployeeAdjustment[]
  items       PayrollItem[]

  @@unique([id, tenantId, factoryId])
  @@unique([tenantId, factoryId, month])
  @@index([tenantId, status])
  @@index([tenantId, factoryId, month])
}

model PayrollItem {
  id                  String            @id @default(cuid())
  tenantId            String
  factoryId           String
  payrollPeriodId     String
  employeeId          String
  workedAmount        Decimal           @db.Decimal(14, 2)
  bonusAmount         Decimal           @db.Decimal(14, 2)
  penaltyAmount       Decimal           @db.Decimal(14, 2)
  advanceAmount       Decimal           @db.Decimal(14, 2)
  finalAmount         Decimal           @db.Decimal(14, 2)
  paidAmount          Decimal           @db.Decimal(14, 2)
  remainingAmount     Decimal           @db.Decimal(14, 2)
  status              PayrollItemStatus @default(CALCULATED)
  calculationSnapshot Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  factory       Factory          @relation(fields: [factoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  payrollPeriod PayrollPeriod    @relation(fields: [payrollPeriodId, tenantId, factoryId], references: [id, tenantId, factoryId], onDelete: Restrict)
  employee      Employee         @relation(fields: [employeeId, tenantId, factoryId], references: [id, tenantId, factoryId], onDelete: Restrict)
  payments      PayrollPayment[]

  @@unique([id, tenantId])
  @@unique([tenantId, payrollPeriodId, employeeId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, factoryId, payrollPeriodId])
}

model PayrollPayment {
  id            String        @id @default(cuid())
  tenantId      String
  payrollItemId String
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  paidAt        DateTime
  paidByUserId  String?
  note          String?
  createdAt     DateTime      @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollItem PayrollItem @relation(fields: [payrollItemId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paidBy      User?       @relation("PayrollPaymentPayer", fields: [paidByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, payrollItemId])
  @@index([tenantId, paidAt])
}
