# Runtime environment
NODE_ENV=development
PORT=3001

# Required by Prisma commands once a local PostgreSQL database is available.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# No migration is run automatically from this configuration.
DATABASE_URL=postgresql://user:password@localhost:5432/paypoq_os?schema=public

# Comma-separated origins are supported for future web/admin clients.
# PRODUCTION: must be an explicit https allowlist — '*', localhost and empty
# values are rejected at startup.
CORS_ORIGIN=http://localhost:3000

# Non-secret build identifier reported by GET /health (set at build/deploy time).
# BUILD_SHA=""

# One-shot operator bootstrap inputs for `pnpm --filter @paypoq/api
# bootstrap:platform-admin`. NOT runtime configuration — the API never reads
# them. Never commit real values.
# PLATFORM_BOOTSTRAP_EMAIL=ops@example.com
# PLATFORM_BOOTSTRAP_PASSWORD=

# Local auth defaults. Use a long random value in real deployments.
JWT_ACCESS_SECRET=local-development-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=paypoq_refresh_token

# Platform admin auth. Local defaults only; use long random values in real deployments.
PLATFORM_JWT_ACCESS_SECRET=local-development-platform-jwt-secret-change-me
PLATFORM_AUTH_COOKIE_NAME=paypoq_platform_refresh_token

# Telegram link tokens. Local default only; use a long random value in real deployments.
TELEGRAM_LINK_TOKEN_SECRET=local-development-telegram-link-token-secret-change-me

# Internal bot-to-API authentication. Local default only; use a long random value in real deployments.
BOT_INTERNAL_API_KEY=local-development-bot-internal-api-key-change-me

# Factory TV display token. Required by GET /dashboard/factory-tv-summary.
FACTORY_TV_ACCESS_TOKEN=local-development-factory-tv-token-change-me
