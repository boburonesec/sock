# Paypoq Telegram bot — local/dev template only.
# Never commit real tokens. Production secrets live in password manager + server env.

# polling (default) or disabled for credential-free local/container rehearsal
BOT_MODE=polling

# BotFather token (required only in polling mode)
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# Internal API base (prefer private network in production, e.g. http://127.0.0.1:3001)
API_BASE_URL=http://127.0.0.1:3001

# Must match API BOT_INTERNAL_API_KEY exactly
BOT_INTERNAL_API_KEY=local-development-bot-internal-api-key-change-me
