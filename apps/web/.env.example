# NestJS API base URL used by the browser (and as TV proxy fallback).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: internal API URL for server-side Factory TV proxy (Docker: http://api:3001).
# Falls back to NEXT_PUBLIC_API_URL when unset.
# API_INTERNAL_URL=http://localhost:3001

# Server-only Factory TV token (preferred). Never expose via NEXT_PUBLIC_*.
FACTORY_TV_ACCESS_TOKEN=local-development-factory-tv-token-change-me

# Legacy browser token — deprecated. Prefer FACTORY_TV_ACCESS_TOKEN on the web server.
# NEXT_PUBLIC_FACTORY_TV_ACCESS_TOKEN=local-development-factory-tv-token-change-me
